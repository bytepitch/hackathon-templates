# Where the API runs. In development the dev server forwards /api to it.
# A production build (npm run build) calls it directly from the browser
VITE_API_URL=http://localhost:3000

# Where `npm run api:generate` reads the OpenAPI document from.
# Defaults to <VITE_API_URL>/api/openapi.json
# OPENAPI_URL=http://localhost:3000/openapi.json
