import { ValidationError } from '../../../shared/domain/errors.js';
import { <%= Entity %> } from './<%= entityFile %>.js';

describe('<%= Entity %>', () => {
  it('trims the name', () => {
    expect(<%= Entity %>.create('  Coffee ').name).toBe('Coffee');
  });

  it('has no id until it is saved', () => {
    expect(<%= Entity %>.create('Coffee').id).toBeNull();
  });

  it('rejects an empty name', () => {
    expect(() => <%= Entity %>.create('   ')).toThrow(ValidationError);
  });

  it('rejects a name longer than 100 characters', () => {
    expect(() => <%= Entity %>.create('a'.repeat(101))).toThrow(ValidationError);
  });
});
