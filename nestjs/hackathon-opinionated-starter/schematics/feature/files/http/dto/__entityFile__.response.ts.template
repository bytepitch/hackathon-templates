import { ApiProperty } from '@nestjs/swagger';
import type { <%= Entity %> } from '../../domain/<%= entityFile %>.js';

export class <%= Entity %>Response {
  @ApiProperty({ example: 1 })
  id: number;

  @ApiProperty({ example: 'Coffee' })
  name: string;

  @ApiProperty()
  createdAt: Date;

  static from(<%= entity %>: <%= Entity %>): <%= Entity %>Response {
    return { id: <%= entity %>.id!, name: <%= entity %>.name, createdAt: <%= entity %>.createdAt };
  }
}
